# Copy to .env.local and fill in. All of these are read on the server only —
# none are prefixed NEXT_PUBLIC_ except the site URL, so no secret reaches the browser.

# Public URL of the deployed site (used for canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Booking form delivery (pick one) ─────────────────────────────────────────
# Option A: email via Resend (https://resend.com). BOOKING_EMAIL receives enquiries.
RESEND_API_KEY=
BOOKING_EMAIL=
# Sender address on a domain you've verified in Resend (defaults to Resend's test sender).
CONTACT_FROM_EMAIL=

# Option B: POST each enquiry as JSON to a webhook (Zapier, Make, Slack workflow, CRM…).
CONTACT_WEBHOOK_URL=
